# Public site URL (update once you bind your custom domain)
NEXT_PUBLIC_SITE_URL=https://usevaultpdf.com

# Google Search Console HTML tag verification code (the content="..." value)
NEXT_PUBLIC_GSC_VERIFICATION=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google AdSense Publisher ID (e.g. ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_ID=

# Optional: set to "true" locally if you want to preview AdSlot spacing before AdSense approval
NEXT_PUBLIC_AD_PREVIEW=false
